{
  "name": "instantreels",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Quranic educational reels \u2014 PWA + rendering worker",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && npm run typecheck -w @instantreels/web",
    "test": "node scripts/run-tests.mjs",
    "fixture:surah1": "tsx packages/importer/src/cli/extract-fixture.ts 1",
    "poc:render": "tsx apps/worker/src/poc/render-poc.ts",
    "poc:validate": "tsx apps/worker/src/poc/validate-poc.ts",
    "asset:bismillah": "tsx scripts/assets/prepare-bismillah.ts",
    "dev": "npm run dev -w @instantreels/web",
    "build:web": "npm run build -w @instantreels/web",
    "lint": "npm run lint -w @instantreels/web",
    "qa:responsive": "tsx scripts/qa/responsive-check.ts",
    "asset:icons": "tsx scripts/assets/generate-icons.ts"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "@types/pngjs": "6.0.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "potrace": "2.1.8",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
