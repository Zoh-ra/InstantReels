# InstantReels — environment template
# Copy to .env.local and fill in real values. NEVER commit .env.local.
# Variables prefixed NEXT_PUBLIC_ are exposed to the browser: only put public values there.

# ── Supabase (Dashboard → your project) ────────────────────────────────
# Project URL: "Connect" button (top bar) or Project Settings → Data API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key (safe for the browser, protected by RLS):
# Project Settings → API Keys → "Publishable key" (starts with sb_publishable_)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# Secret key (SERVER AND WORKER ONLY, bypasses RLS):
# Project Settings → API Keys → "Secret keys" → create/reveal (starts with sb_secret_)
SUPABASE_SECRET_KEY=sb_secret_replace_me
# Project reference id (used by the Supabase CLI): Project Settings → General → Project ID
SUPABASE_PROJECT_REF=your-project-ref
# Postgres connection string for migrations and the pg-boss job queue (SERVER/WORKER ONLY).
# "Connect" button → Connection string → "Session pooler" (port 5432). Replace [YOUR-PASSWORD]
# with the database password (Project Settings → Database → reset it if unknown).
SUPABASE_DB_URL=postgresql://postgres.your-project-ref:YOUR-DB-PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres

# ── Supabase Storage bucket names (created by migrations in Phase 2) ──
SUPABASE_BUCKET_AUDIO=audio
SUPABASE_BUCKET_BACKGROUNDS=backgrounds
SUPABASE_BUCKET_EXPORTS=exports
SUPABASE_BUCKET_BRANDING=branding

# ── Pexels (SERVER ONLY) — https://www.pexels.com/api/ → "Your API key" ──
PEXELS_API_KEY=replace_me

# ── Render worker ─────────────────────────────────────────────────────
# Leave FFMPEG_PATH / FFPROBE_PATH empty to use the binaries found on PATH.
FFMPEG_PATH=
FFPROBE_PATH=
# Chromium used by Playwright: "chrome" = installed Google Chrome (local dev),
# empty = Playwright's bundled Chromium (Docker worker).
RENDER_BROWSER_CHANNEL=chrome
RENDER_TMP_DIR=./tmp/render
RENDER_CONCURRENCY=1
# Path to the word-by-word workbook (owner data, not committed)
WBW_XLSX_PATH=C:\path\to\Traduction mot a mot du Coran - Dr Usama Nonnenmacher (1).xlsx

# Quran Foundation Surah Names font (loaded at render time, not stored — see docs/DECISIONS.md D-15)
SURAH_NAMES_FONT_URL=https://verses.quran.foundation/fonts/quran/surah-names/v1/sura_names.woff2

# Supabase Storage upload limit per object (free plan: 50 MB). Exports above it are kept by the worker.
STORAGE_MAX_UPLOAD_MB=50
NEXT_PUBLIC_STORAGE_MAX_UPLOAD_MB=50
# Folder where the worker keeps exports larger than the Storage limit (served by /api/exports/<job>)
EXPORTS_DIR=output/exports

# ── App ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
